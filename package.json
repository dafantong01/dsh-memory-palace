{
  "name": "@dafantong01/dsh-memory-palace",
  "version": "0.3.5",
  "description": "本地长期记忆：在上下文压力升高时归档较早的整轮原文，压缩后可读回；支持 identity/profile/rules/memories 四板块分级注入、项目档案与项目热记忆、记忆家族与根转移、手动注入、20K 长文分段、tag 关联检索。数据都保存在当前工作区，不依赖外部记忆服务。",
  "author": "DaFanTong",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "check:meta": "node scripts/check-meta.mjs .",
    "test:family": "node tests/family-regression.mjs"
  },
  "files": [
    "lib",
    "locale",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "memory",
    "archive",
    "session-archive",
    "context-compaction",
    "long-term-memory",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafantong01/dsh-memory-palace.git"
  },
  "homepage": "https://github.com/dafantong01/dsh-memory-palace#readme",
  "bugs": {
    "url": "https://github.com/dafantong01/dsh-memory-palace/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "fzstd": "^0.1.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
